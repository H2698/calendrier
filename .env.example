# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
APP_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.vercel.app
TIME_ZONE=Africa/Tunis
SECURE_HSTS_SECONDS=31536000

# Email (use an SMTP backend in production before enabling password reset emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Database (pooled Neon/Vercel Postgres connection string in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_CONN_MAX_AGE=0

# Local development only. Never enable this in production.
USE_SQLITE=True

# Web Push (configured in Phase 10)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=replace-with-a-random-secret
